# Sem valor, o site e o APK usam os JSONs incluídos no build em /data.
# Para o APK consultar dados atualizados, informe a URL pública da pasta data.
# Exemplo: VITE_DADOS_BASE_URL=https://mapa-concursos.exemplo.com/data
VITE_DADOS_BASE_URL=

# URL e chave anônima pública do projeto Supabase. Não use nem exponha a service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
